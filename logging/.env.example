# Compose projects whose containers log to journald with tag "<project>-<service>".
# Space-separated; re-run scripts/install.sh after changing.
LOG_PROJECTS="acme dfd dns drive jdownloader"

# Absolute path on the NAS where per-tag log files are written.
LOG_DIR=/volume1/logs/docker

# How often to rotate: daily, weekly, monthly or yearly.
LOG_ROTATE_PERIOD=daily
# Number of rotated files to keep, counted in LOG_ROTATE_PERIOD units.
LOG_ROTATE_KEEP=14

# syslog-ng systemd unit; check with: systemctl list-units --all | grep -i syslog
SYSLOG_UNIT=syslog-ng
