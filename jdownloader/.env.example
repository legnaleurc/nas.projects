# NAS LAN IP; bind the browser interface to this address.
JDOWNLOADER_HOST=192.168.0.10
JDOWNLOADER_PORT=5800

# Run `id your_username` over SSH on the NAS and enter uid and gid.
JDOWNLOADER_USER_ID=
JDOWNLOADER_GROUP_ID=

# Absolute paths on the NAS; adjust volume and shared folder names.
JDOWNLOADER_CONFIG_PATH=/volume1/docker/jdownloader
JDOWNLOADER_DOWNLOAD_PATH=/volume1/downloads
